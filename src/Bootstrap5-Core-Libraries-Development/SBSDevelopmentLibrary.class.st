"
Default development library
"
Class {
	#name : 'SBSDevelopmentLibrary',
	#superclass : 'SBSFileLibrary',
	#category : 'Bootstrap5-Core-Libraries-Development-Base',
	#package : 'Bootstrap5-Core-Libraries-Development',
	#tag : 'Base'
}

{ #category : 'updating' }
SBSDevelopmentLibrary class >> addLoadScriptTo: html [

	html script
			url: self / #jsbootstrapbundleJs
]

{ #category : 'uploaded metadata' }
SBSDevelopmentLibrary >> cssbootstrapCss [
	^ WAFileLibraryResource
		filepath: 'css/bootstrap.css'
		mimeType: (WAMimeType main: 'text' sub: 'css')
		cacheDuration: (Duration days: 0 hours: 0 minutes: 30 seconds: 0)
		contents: (GRDelayedSend receiver: self selector: #cssbootstrapCssContent)
]

{ #category : 'uploaded' }
SBSDevelopmentLibrary >> cssbootstrapCssContent [
